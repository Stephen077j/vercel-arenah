# ─── Secrets ────────────────────────────────────────────────────────────────
# Aucun fichier d'environnement ne doit être versionné, hormis l'exemple.
.env
.env.*
!.env.example

# ─── Dépendances & artefacts de build ───────────────────────────────────────
node_modules
dist
dist-ssr
build
.vite
*.tsbuildinfo

# ─── Logs ───────────────────────────────────────────────────────────────────
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Bases de données locales ───────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ─── Fichiers envoyés par les utilisateurs ──────────────────────────────────
# Contenu utilisateur, absent du dépôt. Le .gitkeep préserve le dossier.
public/uploads/*
!public/uploads/.gitkeep

# ─── Tests & couverture ─────────────────────────────────────────────────────
coverage
.nyc_output

# ─── Éditeurs & OS ──────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── Hébergement ────────────────────────────────────────────────────────────
.vercel
.netlify

# ─── Modèles d'IA téléchargés (réseau de neurones) ─────────────────────
.cache
