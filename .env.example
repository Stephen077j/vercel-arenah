# ============================================================================
# ARENAH — Modèle de configuration
#
# Copiez ce fichier vers .env.local pour le développement :
#     cp .env.example .env.local
#
# En production, renseignez ces variables dans l'interface de votre hébergeur.
# Ne mettez JAMAIS de vraie valeur dans ce fichier : il est versionné.
# ============================================================================


# ─── OBLIGATOIRE — le serveur refuse de démarrer sans ces variables ─────────

# Secret de signature des jetons JWT.
# Minimum 32 caractères en production. Générez-en un avec :
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Base de données PostgreSQL — deux modes au choix.
#
# Mode 1 (recommandé en production) : chaîne de connexion complète, fournie
# telle quelle par les PostgreSQL managés. Si elle est présente, elle a priorité
# sur les variables séparées ci-dessous.
# DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/base?sslmode=require

# Mode 2 (développement local) : variables séparées.
# DB_PASSWORD n'a aucune valeur par défaut — il est obligatoire.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=arenah
DB_USER=postgres
DB_PASSWORD=

# TLS vers la base. "true" pour un PostgreSQL managé, "false" en local.
# Ignoré si DATABASE_URL est utilisé (TLS activé par défaut dans ce cas).
DB_SSL=false


# ─── Serveur & CORS ────────────────────────────────────────────────────────

PORT=3001
NODE_ENV=development

# Origines autorisées à appeler l'API, séparées par des virgules.
# En production, mettez le domaine réel du frontend.
# Obligatoire en production — le serveur refuse de démarrer sans.
CLIENT_ORIGIN=http://localhost:8080,http://localhost:5173

# URL publique du frontend (liens dans les e-mails).
FRONTEND_URL=http://localhost:8080

# URL publique de cette API (callbacks des opérateurs de paiement).
API_BASE_URL=http://localhost:3001

# Durée de validité des jetons de session.
JWT_EXPIRES_IN=7d


# ─── Frontend (Vite) ───────────────────────────────────────────────────────
# Les variables VITE_* sont injectées dans le bundle au build : elles sont
# donc PUBLIQUES. N'y mettez jamais de secret.

# URL de l'API appelée par le navigateur.
VITE_API_URL=http://localhost:3001

# Clé publique VAPID pour les notifications push (publique par nature).
VITE_VAPID_PUBLIC_KEY=


# ─── Tâches planifiées ─────────────────────────────────────────────────────

# "true" sur un serveur qui reste allumé (VPS, conteneur permanent).
# "false" en serverless : le processus s'arrête entre les requêtes et
# l'ordonnanceur interne ne se déclencherait jamais.
ENABLE_CRON=true

# Secret partagé avec l'ordonnanceur externe qui appellera
# POST /api/cron/:job via l'en-tête x-cron-secret.
# Laissé vide, le déclenchement HTTP est désactivé (réponse 503).
CRON_TRIGGER_SECRET=


# ─── Stockage des fichiers envoyés ─────────────────────────────────────────

# "local" = disque du serveur. Attention : éphémère sur les hébergements
# gratuits, les fichiers disparaissent à chaque redéploiement.
STORAGE_DRIVER=local

# Domaine servant les fichiers, si différent de l'API (CDN, stockage objet).
STORAGE_PUBLIC_URL=


# ─── FACULTATIF — intégrations externes ────────────────────────────────────
# Non renseignées, ces fonctionnalités se désactivent proprement sans
# empêcher le serveur de démarrer.

# E-mail (SMTP)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
SUPERADMIN_EMAIL=

# SMS (Infobip)
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
SMS_SENDER=ARENAH

# Notifications push (VAPID) — la clé privée est un SECRET
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@exemple.com

# Paiement — MVola (Telma)
MVOLA_CONSUMER_KEY=
MVOLA_CONSUMER_SECRET=
MVOLA_MERCHANT_NUMBER=
MVOLA_PARTNER_NAME=

# Paiement — Orange Money
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_MERCHANT_KEY=
ORANGE_MERCHANT_NUMBER=

# Paiement — Airtel Money
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_MERCHANT_NUMBER=

# "production" bascule les API opérateurs du sandbox vers le réel
PAYMENT_ENV=sandbox
PAYMENT_FEE_PERCENT=0

# Fidélité
LOYALTY_POINTS_PER_100AR=1
LOYALTY_REDEEM_RATE=100


# ─── Supabase ──────────────────────────────────────────────────────────────
# Le portail Super Admin est passé sur l'API Express : ces variables ne sont
# nécessaires que si vous réactivez les fonctionnalités Supabase résiduelles.
VITE_USE_SUPABASE=false
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
